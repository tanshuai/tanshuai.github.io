{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Nothing to install.'",
  "buildCommand": "echo 'Static site: nothing to build.'",
  "outputDirectory": "sites/vercel",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path((?!(?:index\\.html|favicon\\.svg|favicon\\.ico|apple-touch-icon\\.png|avatar\\.png|avatar-384\\.webp|seal\\.svg|robots\\.txt|sitemap\\.xml)$).+)",
      "destination": "https://tanshuai.com/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
